<Project>
  <PropertyGroup>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://virmaniapi.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ProjectGuid>cd21aa87-ba13-41e0-a8e9-bbc23aacf525</ProjectGuid>
    <PublishUrl>https://virmaniapi.scm.azurewebsites.net/</PublishUrl>
    <UserName>$virmaniapi</UserName>
    <_SavePWD>true</_SavePWD>
  </PropertyGroup>
</Project>